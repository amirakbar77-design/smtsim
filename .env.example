# Copy to .env and fill in. Nothing here is a working credential.
#
# docker compose reads this file automatically. Every variable the service
# understands is listed; the ones without a default must be set.

# --- database ---------------------------------------------------------------
# Postgres superuser credentials used by the db container on first start.
# There is deliberately no default password: an unset one fails loudly rather
# than silently giving you a database anyone can reach.
POSTGRES_USER=smtsim
POSTGRES_PASSWORD=
POSTGRES_DB=smtsim

# What the API connects with. Host `db` is the compose service name.
SMTSIM_DATABASE_URL=postgresql://smtsim:CHANGEME@db:5432/smtsim

# --- service ----------------------------------------------------------------
SMTSIM_HOST=0.0.0.0
SMTSIM_PORT=8000
SMTSIM_LOG_LEVEL=info

# How many simulations may run at once. See the README on why these are
# threads and not processes.
SMTSIM_WORKER_THREADS=2

# Database pool bounds.
SMTSIM_DB_POOL_MIN=1
SMTSIM_DB_POOL_MAX=8

# --- websocket streaming ----------------------------------------------------
# Flush a frame when this many events have accumulated, or after this many
# milliseconds, whichever comes first.
SMTSIM_WS_BATCH_SIZE=250
SMTSIM_WS_BATCH_INTERVAL_MS=100

# How many batches may sit unsent for one slow client before it is disconnected.
SMTSIM_WS_QUEUE_MAXSIZE=64

# --- limits -----------------------------------------------------------------
SMTSIM_MAX_MINUTES=20160
SMTSIM_MAX_COMPARISON_SEEDS=200
